# ==============================================================================
# PideGas MVP - Variables de Entorno de Referencia (.env.example)
# ==============================================================================
COMPOSE_PROJECT_NAME=rappigas

# Base de Datos PostgreSQL + PostGIS
POSTGRES_DB=pidegas_db
POSTGRES_USER=pidegas_user
POSTGRES_PASSWORD=pidegas_secure_password_123!
POSTGRES_PORT=5432

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pidegas_db
SPRING_DATASOURCE_USERNAME=pidegas_user
SPRING_DATASOURCE_PASSWORD=pidegas_secure_password_123!

# Seguridad y Tokens JWT (Secret min 256 bits en base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# API Gateway y Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# Google Maps Platform (Geocodificación y Mapas)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=mock-google-maps-browser-key
GOOGLE_MAPS_SERVER_API_KEY=mock-google-maps-server-key

# Almacenamiento de Archivos y Evidencias
FILE_STORAGE_PATH=/var/pidegas/uploads

# Proveedor de Pagos
PAYMENT_PROVIDER=MOCK
PAYMENT_API_KEY=mock-payment-key-test
