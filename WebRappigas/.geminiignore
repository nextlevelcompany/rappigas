# ==============================================================================
# .geminiignore (Compatibilidad con Gemini CLI / Antigravity)
# ==============================================================================

# Dependencias y Gestores
node_modules/
.pnp/
.pnp.js
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Builds y Salidas de Next.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Secretos y Variables de Entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env*.local
*.pem
*.key
*.cert
*.crt
*.pfx
id_rsa
id_rsa.pub
*.keystore
secrets/
credentials.json
service-account*.json
!*.example

# Logs y Debug
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura y Pruebas
coverage/
.nyc_output/
playwright-report/
test-results/
.cypress/

# Caché y Temporales
.cache/
.parcel-cache/
.turbo/
.swc/
.temp/
.tmp/
tmp/

# Despliegue
.vercel/
.netlify/

# Sistema e IDEs
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Control de Versiones e IA
.git/
.gemini/
.antigravity/
.system_generated/

# Binarios y Medios Pesados
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.pdf
*.exe
*.dll
*.so
*.dylib
*.iso
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.ogg
*.woff
*.woff2
*.ttf
